# The public origin, used for canonicals, hreflang, og:url, the sitemap, the
# robots.txt Host line and every @id in the structured data.
#
# No trailing slash — one is stripped anyway. If this is unset the code falls
# back to the production origin below rather than to a preview hostname, so a
# deployment that never got the variable publishes a canonical that is correct
# rather than one nominating a staging host as the real home of the page.
NEXT_PUBLIC_SITE_URL=https://dev.sot.com.sa
